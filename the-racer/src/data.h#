        v.push(circ("Abu Dhabi", "UAE", 58, 22.0, 0.02, 0.8, 1.0, false))
    elsif series == 1 is
        let mut i: int = 0
        while i < 17 is
            v.push(circ("Round " + to_string(i + 1), "USA", 200, 12.0, 0.20, 1.5, 1.0, true))
            i += 1
        end
    elsif series == 2 is
        let mut i: int = 0
        while i < 16 is
            v.push(circ("E-Prix R" + to_string(i + 1), "INT", 30, 0.0, 0.25, 1.1, 0.5, false))
            i += 1
        end
    elsif series == 3 is
        v.push(circ("Sebring", "USA", 350, 60.0, 0.25, 1.2, 1.4, false))
        v.push(circ("Portimão", "PRT", 280, 55.0, 0.30, 1.0, 1.2, false))
