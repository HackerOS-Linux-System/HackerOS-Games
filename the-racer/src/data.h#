pub fn default_driver(name: string, nationality: string, pace: int, salary: int) -> types::Driver is
    return types::Driver {
        name: name, nationality: nationality,
        age: types::ri(20, 38),
        pace: pace,
        consistency: types::ri(60, 92),
        wet_skill: types::ri(55, 92),
        tire_mgmt: types::ri(55, 88),
        experience: types::ri(30, 85),
        salary: salary,
        morale: 50,
        contract_years: types::ri(1, 4),
        career_wins: types::ri(0, 20),
        races: types::ri(30, 200),
    }
end

pub fn new_team(name: string, d1: string, d2: string, series: int) -> types::Team is
    return types::Team {
        name: name,
        budget: 50000,
        driver1: default_driver(d1, "PL", 72, 800),
        driver2: default_driver(d2, "PL", 68, 600),
        car: types::Car { chassis: 60, engine: 62, reliability: 65, tire_deg: 60, pit_speed: 65, aero_balance: 50 },
        rd_projects: [],
        standings_points: 0,
        race_results: [],
        series: series,
        current_round: 0,
    }
end

fn opp(name: string, strength: int, r: f64, g: f64, b: f64) -> types::OpponentTeam is
    return types::OpponentTeam { name: name, strength: strength, points: 0, color_r: r, color_g: g, color_b: b }
end

