fn circ(name: string, country: string, laps: int, pit_delta: f64, wet: f64, ot: f64, ts: f64, hs: bool) -> types::Circuit is
    return types::Circuit { name: name, country: country, laps: laps, pit_delta: pit_delta, wet_chance: wet, overtake_diff: ot, tire_stress: ts, high_speed: hs }
end

