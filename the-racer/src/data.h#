        v.push(circ("Qatar", "QAT", 320, 55.0, 0.02, 0.9, 1.3, true))
    else is
        let mut i: int = 0
        while i < 12 is
            v.push(circ("Round " + to_string(i + 1), "EUR", 100, 30.0, 0.30, 1.1, 1.0, false))
            i += 1
        end
    end
    return v
end

