;; ── Data structs ──────────────────────────────────────────────────────────
pub struct Driver is
    pub name:           string
    pub nationality:    string
    pub age:            int
    pub pace:           int
    pub consistency:    int
    pub wet_skill:      int
    pub tire_mgmt:      int
    pub experience:     int
    pub salary:         int
    pub morale:         int
    pub contract_years: int
    pub career_wins:    int      ;; championship wins
    pub races:          int      ;; races completed
end

pub fn driver_overall(d: Driver) -> int is
    return (d.pace + d.consistency + d.wet_skill + d.tire_mgmt + d.experience) / 5
end

pub fn driver_race_performance(d: Driver, wet: bool) -> f64 is
    let mut base: f64 = i2f(d.pace) * 0.6 + i2f(d.consistency) * 0.4
    if wet is base = i2f(d.pace) * 0.4 + i2f(d.wet_skill) * 0.6 end
    let variance: f64 = rf(0.0 - 8.0, 8.0)
    let morale_bonus: f64 = i2f(d.morale) * 0.05
    let exp_bonus: f64 = i2f(d.experience) * 0.04     ;; small edge in tight battles
    return fclamp(base + variance + morale_bonus + exp_bonus, 0.0, 105.0)
end

pub struct Car is
    pub chassis:      int
    pub engine:       int
    pub reliability:  int
    pub tire_deg:     int
    pub pit_speed:    int
    pub aero_balance: int     ;; 0 = understeer, 100 = oversteer
end

pub fn car_performance(c: Car) -> int is
    return (c.chassis + c.engine + c.reliability) / 3
end

