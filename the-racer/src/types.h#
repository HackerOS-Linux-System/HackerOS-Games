use "std -> strings" from "str"
use "bit -> h2d"

;; The Racer — types.h#  (port of the-racer/src/types.rs)
;;
;; H# has no `&mut`, Option or enum-with-methods across modules, so:
;;  * Series / TireCompound / Screen are ints with named getters + helper fns;
;;  * Option<T> is a flag next to the value (`has_result`, `dnf_driver == 0`, `msg == ""`);
;;  * every function takes a value and returns the new one (AppState / Team flow through).

;; ── helpers ───────────────────────────────────────────────────────────────
pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> h2d_color::Color is
    return h2d_color::color(f2i(r * 255.0 + 0.5), f2i(g * 255.0 + 0.5), f2i(b * 255.0 + 0.5), f2i(a * 255.0 + 0.5))
end

pub fn f2i(x: f64) -> int is
    return __builtin_conv_float_to_int(x)
end

pub fn i2f(n: int) -> f64 is
    return n + 0.0
end

pub fn imin(a: int, b: int) -> int is
    if a < b is return a end
    return b
end

pub fn imax(a: int, b: int) -> int is
    if a > b is return a end
    return b
end

pub fn iclamp(v: int, lo: int, hi: int) -> int is
    if v < lo is return lo end
    if v > hi is return hi end
    return v
end

pub fn fclamp(v: f64, lo: f64, hi: f64) -> f64 is
    if v < lo is return lo end
    if v > hi is return hi end
    return v
end

;; uniform f64 in [lo, hi)
pub fn rf(lo: f64, hi: f64) -> f64 is
    return lo + (hi - lo) * ((h2d_random::range(0, 999999) + 0.0) / 1000000.0)
end

;; uniform int in [lo, hi)  (Rust's gen_range(lo..hi))
pub fn ri(lo: int, hi: int) -> int is
    return h2d_random::range(lo, hi - 1)
end

;; "{:.1}" for non-negative numbers
pub fn fmt1(x: f64) -> string is
    let n: int = f2i(x * 10.0 + 0.5)
    return to_string(n / 10) + "." + to_string(n % 10)
end

pub fn pad2(n: int) -> string is
    return str::pad_start(to_string(n), 2, " ")
end

