pub struct RaceWeekendState is
    pub practice_done:    bool
    pub qualifying_done:  bool
    pub qualifying_pos1:  int
    pub qualifying_pos2:  int
    pub strategy1:        int
    pub strategy2:        int
    pub pit_lap1:         int
    pub pit_lap2:         int
    pub wet:              bool
    pub sim_progress:     f64
    pub sim_done:         bool
    pub has_result:       bool        ;; Option<RaceResult>
    pub result:           RaceResult
    pub log:              [string]
end

pub fn empty_result() -> RaceResult is
    return RaceResult { round: 0, circuit: "", driver1_pos: 0, driver2_pos: 0, driver1_points: 0, driver2_points: 0, fastest_lap: false, dnf_driver: 0, wet_race: false, pit_stops: [] }
end

pub fn new_race_state() -> RaceWeekendState is
    return RaceWeekendState {
        practice_done: false, qualifying_done: false,
        qualifying_pos1: 5, qualifying_pos2: 8,
        strategy1: t_soft(), strategy2: t_medium(),
        pit_lap1: 20, pit_lap2: 25,
        wet: false, sim_progress: 0.0, sim_done: false,
        has_result: false, result: empty_result(), log: [],
    }
end

pub fn empty_driver() -> Driver is
    return Driver { name: "", nationality: "", age: 0, pace: 0, consistency: 0, wet_skill: 0, tire_mgmt: 0, experience: 0, salary: 0, morale: 0, contract_years: 0, career_wins: 0, races: 0 }
end

pub fn empty_team() -> Team is
    return Team {
        name: "", budget: 0, driver1: empty_driver(), driver2: empty_driver(),
        car: Car { chassis: 0, engine: 0, reliability: 0, tire_deg: 0, pit_speed: 0, aero_balance: 0 },
        rd_projects: [], standings_points: 0, race_results: [], series: 0, current_round: 0,
    }
end

pub struct AppState is
    pub screen:          int
    pub has_team:        bool          ;; Option<Team>
    pub team:            Team
    pub opponents:       [OpponentTeam]
    pub circuits:        [Circuit]     ;; rebuilt by main when the series changes
    pub race_state:      RaceWeekendState
    pub scroll:          f64
    pub input_buf:       string
    pub setup_step:      int
    pub setup_name:      string
    pub setup_driver1:   string
    pub setup_driver2:   string
    pub msg:             string        ;; Option<(String, f32)>: "" = None
    pub msg_t:           f64
    pub has_series:      bool          ;; Option<Series>
    pub selected_series: int
    pub has_rd:          bool          ;; Option<usize>
    pub selected_rd:     int
    pub tab:             int
    pub contract_msg:    string        ;; "" = None
    pub agents:          [Driver]      ;; contract-market list, rolled once per visit (see screens.h#)
end

pub fn new_app_state() -> AppState is
    return AppState {
        screen: sc_main_menu(), has_team: false, team: empty_team(),
        opponents: [], circuits: [], race_state: new_race_state(),
        scroll: 0.0, input_buf: "", setup_step: 0,
        setup_name: "", setup_driver1: "", setup_driver2: "",
        msg: "", msg_t: 0.0, has_series: false, selected_series: 0,
        has_rd: false, selected_rd: 0, tab: 0, contract_msg: "", agents: [],
    }
end

pub fn show_msg(mut gs: AppState, msg: string) -> AppState is
    gs.msg = msg
    gs.msg_t = 3.0
    return gs
end

pub fn points_for_pos(pos: int) -> int is
    if pos == 1 is return 25 end
    if pos == 2 is return 18 end
    if pos == 3 is return 15 end
    if pos == 4 is return 12 end
    if pos == 5 is return 10 end
    if pos == 6 is return 8 end
    if pos == 7 is return 6 end
    if pos == 8 is return 4 end
    if pos == 9 is return 2 end
    if pos == 10 is return 1 end
    return 0
end
