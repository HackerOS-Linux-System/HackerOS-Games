;; colour `c` with a different alpha (0..1), e.g. Color::new(col.r, col.g, col.b, 0.1)
pub fn alpha(c: h2d_color::Color, a: f64) -> h2d_color::Color is
    return h2d_color::with_alpha(c, f2i(a * 255.0 + 0.5))
end

