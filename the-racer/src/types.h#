    pub wet_chance:    f64
    pub overtake_diff: f64
    pub tire_stress:   f64
    pub high_speed:    bool    ;; true = rewards high chassis, false = low-speed
end

pub struct RaceResult is
    pub round:          int
    pub circuit:        string
    pub driver1_pos:    int
    pub driver2_pos:    int
    pub driver1_points: int
    pub driver2_points: int
    pub fastest_lap:    bool
    pub dnf_driver:     int        ;; Option<u8>: 0 = none, 1 / 2 = driver
    pub wet_race:       bool
    pub pit_stops:      [string]
end

pub struct Team is
    pub name:             string
    pub budget:           int
    pub driver1:          Driver
    pub driver2:          Driver
    pub car:              Car
    pub rd_projects:      [RdProject]
    pub standings_points: int
    pub race_results:     [RaceResult]
    pub series:           int
    pub current_round:    int
end

pub fn weekly_costs(t: Team) -> int is
    return (t.driver1.salary + t.driver2.salary) / 24 + 500
end

pub struct OpponentTeam is
    pub name:     string
    pub strength: int
    pub points:   int
    pub color_r:  f64
    pub color_g:  f64
    pub color_b:  f64
end

pub fn opp_color(o: OpponentTeam) -> h2d_color::Color is
    return rgba(o.color_r, o.color_g, o.color_b, 1.0)
end

