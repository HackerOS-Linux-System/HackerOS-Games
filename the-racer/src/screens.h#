;; The Racer — screens.h#  (port of the-racer/src/screens.rs)
;; Every screen takes the AppState by value and returns the new one.

fn f2i(x: f64) -> int is
    return types::f2i(x)
end

;; "{:.0}" of a non-negative value
fn fmt0(x: f64) -> string is
    return to_string(f2i(x + 0.5))
end

;; ── Main Menu ─────────────────────────────────────────────────────────────

pub fn draw_main_menu(fo: text::Fonts, mut gs: types::AppState) -> types::AppState is
    h2d_gfx::clear_background(types::c_bg())
    let title: string = "THE RACER"
    let sub: string = "MOTORSPORT MANAGEMENT SIMULATOR"
    let tw: f64 = text::width(fo, title, 72)
    let sw2: f64 = text::width(fo, sub, 18)
    let sw: f64 = ui::sw()
    let sh: f64 = ui::sh()
    text::draw(fo, title, sw / 2.0 - tw / 2.0, sh * 0.28, 72, types::c_accent())
    text::draw(fo, sub, sw / 2.0 - sw2 / 2.0, sh * 0.28 + 60.0, 18, types::c_text_dim())
    h2d_gfx::draw_line(sw / 2.0 - 200.0, sh * 0.38, sw / 2.0 + 200.0, sh * 0.38, 1.0, types::c_border())

    let bw: f64 = 260.0
    let bh: f64 = 46.0
    let bx: f64 = sw / 2.0 - bw / 2.0
    if ui::button(fo, "NEW SEASON", bx, sh * 0.42, bw, bh, types::c_accent()) is
        gs.screen = types::sc_series_select()
    end
    if ui::button(fo, "CONTINUE", bx, sh * 0.42 + 58.0, bw, bh, types::c_blue()) is
        let r = save::load_game(gs)
        gs = r.0
        if !r.1 is gs = types::show_msg(gs, "No save file found.") end
    end
    if ui::button(fo, "EXIT", bx, sh * 0.42 + 116.0, bw, bh, types::c_text_dim()) is
        h2d_gfx::request_close()
    end

    text::draw(fo, "v1.1.0", sw - 60.0, sh - 10.0, 14, types::c_text_dim())
    if gs.msg != "" is
        let mw: f64 = text::width(fo, gs.msg, 18)
        text::draw(fo, gs.msg, sw / 2.0 - mw / 2.0, sh - 40.0, 18, types::c_accent())
    end
    return gs
end

;; ── Series Select ─────────────────────────────────────────────────────────

pub fn draw_series_select(fo: text::Fonts, mut gs: types::AppState) -> types::AppState is
    h2d_gfx::clear_background(types::c_bg())
    let sw: f64 = ui::sw()
    let sh: f64 = ui::sh()
    ui::label(fo, "SELECT CHAMPIONSHIP", 30.0, 50.0, 28, types::c_text())
    h2d_gfx::draw_line(30.0, 60.0, sw - 30.0, 60.0, 1.0, types::c_border())

    let names: [string] = ["Formula 1 — 2026 Season", "IndyCar Series", "ABB Formula E", "FIA World Endurance Champ.", "GT3 European Series"]
    let descs: [string] = [
        "24 rounds, hybrid power, 2026 tech regs",
        "17 rounds incl. Indy 500, oval + road",
        "16 rounds, pure electric, no tyre pits",
        "8 rounds incl. 24h Le Mans",
        "12 rounds, production GT cars",
    ]
    let mut i: int = 0
    while i < 5 is
        let y: f64 = 96.0 + types::i2f(i) * 90.0
        let col: h2d_color::Color = types::series_color(i)
        let selected: bool = gs.has_series && gs.selected_series == i
        if selected is
            h2d_gfx::draw_rectangle(30.0, y, sw - 60.0, 80.0, types::alpha(col, 0.10))
            h2d_gfx::draw_rectangle_lines(30.0, y, sw - 60.0, 80.0, 1.5, col)
        else is
            h2d_gfx::draw_rectangle(30.0, y, sw - 60.0, 80.0, types::c_panel())
            h2d_gfx::draw_rectangle_lines(30.0, y, sw - 60.0, 80.0, 1.5, types::c_border())
        end
        h2d_gfx::draw_rectangle(30.0, y, 78.0, 80.0, types::alpha(col, 0.15))
        let short: string = types::series_short(i)
        let bw: f64 = text::width(fo, short, 18)
        text::draw(fo, short, 30.0 + (78.0 - bw) / 2.0, y + 48.0, 18, col)
        text::draw(fo, names[i], 124.0, y + 28.0, 20, types::c_text())
        text::draw(fo, descs[i], 124.0, y + 52.0, 14, types::c_text_dim())
        text::draw(fo, to_string(types::series_rounds(i)) + " rounds", sw - 110.0, y + 28.0, 15, types::c_text_dim())
        if types::pit_stops_required(i) is text::draw(fo, "PIT STOPS", sw - 110.0, y + 48.0, 12, types::c_gold()) end
        if types::has_endurance(i) is text::draw(fo, "ENDURANCE", sw - 110.0, y + 62.0, 12, types::c_blue()) end

        if ui::hovering(30.0, y, sw - 60.0, 80.0) && ui::mouse_clicked() is
            gs.has_series = true
            gs.selected_series = i
        end
        i += 1
    end
    if gs.has_series is
        if ui::button(fo, "SELECT & SETUP TEAM  →", sw / 2.0 - 150.0, sh - 68.0, 300.0, 46.0, types::c_accent()) is
            gs.screen = types::sc_team_setup()
            gs.setup_step = 0
            gs.input_buf = ""
        end
    end
    if ui::button(fo, "← BACK", 30.0, sh - 68.0, 120.0, 40.0, types::c_text_dim()) is
        gs.screen = types::sc_main_menu()
    end
    return gs
end

;; ── Team Setup ────────────────────────────────────────────────────────────

pub fn draw_team_setup(fo: text::Fonts, mut gs: types::AppState) -> types::AppState is
    h2d_gfx::clear_background(types::c_bg())
    let sw: f64 = ui::sw()
    let sh: f64 = ui::sh()
    h2d_input2d::start_text_input()
    ui::label(fo, "TEAM SETUP", 30.0, 50.0, 28, types::c_text())
    h2d_gfx::draw_line(30.0, 60.0, sw - 30.0, 60.0, 1.0, types::c_border())

    let prompts: [string] = ["Team Name:", "Driver 1 Name:", "Driver 2 Name:"]
    let step: int = gs.setup_step

    let mut i: int = 0
    while i < 3 is
        let y: f64 = 130.0 + types::i2f(i) * 90.0
        let done: bool = i < step
        let active: bool = i == step
        let mut val: string = gs.setup_driver2
        if i == 0 is
            val = gs.setup_name
        elsif i == 1 is
            val = gs.setup_driver1
        end
        if active is
            text::draw(fo, prompts[i], 100.0, y, 20, types::c_text())
            h2d_gfx::draw_rectangle(100.0, y + 10.0, 400.0, 36.0, types::c_panel2())
            h2d_gfx::draw_rectangle_lines(100.0, y + 10.0, 400.0, 36.0, 1.5, types::c_accent())
        else is
            text::draw(fo, prompts[i], 100.0, y, 20, types::c_text_dim())
            h2d_gfx::draw_rectangle(100.0, y + 10.0, 400.0, 36.0, types::c_panel())
            h2d_gfx::draw_rectangle_lines(100.0, y + 10.0, 400.0, 36.0, 1.5, types::c_border())
        end
        let mut display: string = val
        if active is display = gs.input_buf + "|" end
        if done is
            text::draw(fo, display, 108.0, y + 33.0, 20, types::c_green())
        else is
            text::draw(fo, display, 108.0, y + 33.0, 20, types::c_text())
        end
        i += 1
    end

    if step < 3 is
        ;; typed characters: printable ASCII only, max 24 (as before)
        let mut c: int = h2d_input2d::get_char_pressed()
        while c != 0 is
            if c >= 33 && c <= 126 || c == 32 is
                if gs.input_buf.len() < 24 is gs.input_buf = gs.input_buf + conv::int_to_char(c) end
            end
            c = h2d_input2d::get_char_pressed()
        end
        if h2d_input2d::is_key_pressed(h2d_keys::key_backspace()) && gs.input_buf.len() > 0 is
            gs.input_buf = str::slice(gs.input_buf, 0, gs.input_buf.len() - 1)
        end
        if h2d_input2d::is_key_pressed(h2d_keys::key_enter()) is
            let val: string = str::trim(gs.input_buf)
            if val.len() > 0 is
                if step == 0 is
                    gs.setup_name = val
                elsif step == 1 is
                    gs.setup_driver1 = val
                else is
                    gs.setup_driver2 = val
                end
                gs.input_buf = ""
                gs.setup_step += 1
            end
        end
    end

    if gs.setup_step >= 3 is
        text::draw(fo, "✓ All set! Ready to start season.", 100.0, 400.0, 20, types::c_green())
        if ui::button(fo, "START SEASON  →", sw / 2.0 - 130.0, sh - 80.0, 260.0, 46.0, types::c_accent()) is
            let mut series: int = types::s_f1()
            if gs.has_series is series = gs.selected_series end
            gs.team = data::new_team(gs.setup_name, gs.setup_driver1, gs.setup_driver2, series)
            gs.has_team = true
            gs.opponents = data::generate_opponents(series)
            gs.screen = types::sc_dashboard()
            gs.tab = 0
            h2d_input2d::stop_text_input()
        end
    end
    if ui::button(fo, "← BACK", 30.0, sh - 80.0, 120.0, 40.0, types::c_text_dim()) is
        gs.screen = types::sc_series_select()
        h2d_input2d::stop_text_input()
    end
    return gs
end

;; ── Dashboard ─────────────────────────────────────────────────────────────

pub fn draw_dashboard(fo: text::Fonts, mut gs: types::AppState) -> types::AppState is
    let team: types::Team = gs.team
    let circuits: [types::Circuit] = gs.circuits
    let sw: f64 = ui::sw()
    h2d_gfx::clear_background(types::c_bg())
    ui::topbar(fo, team, circuits)

    let cy: f64 = 66.0
    if team.current_round < circuits.len() is
        let c: types::Circuit = circuits[team.current_round]
        ui::panel(16.0, cy, sw - 32.0, 106.0, types::c_panel())
        text::draw(fo, "NEXT RACE", 30.0, cy + 22.0, 13, types::c_text_dim())
        text::draw(fo, c.name, 30.0, cy + 54.0, 30, types::c_text())
        text::draw(fo, c.country, 30.0 + text::width(fo, c.name, 30) + 10.0, cy + 54.0, 18, types::c_text_dim())
        text::draw(fo, to_string(c.laps) + " laps", 30.0, cy + 80.0, 14, types::c_text_dim())
        let wx: f64 = sw - 200.0
        let mut wtxt: string = "DRY"
        let mut wcol: h2d_color::Color = types::c_green()
        if c.wet_chance > 0.35 is
            wtxt = "LIKELY RAIN"
            wcol = types::c_blue()
        elsif c.wet_chance > 0.15 is
            wtxt = "POSSIBLE RAIN"
            wcol = types::c_gold()
        end
        text::draw(fo, "WEATHER", wx, cy + 22.0, 13, types::c_text_dim())
        text::draw(fo, wtxt, wx, cy + 54.0, 20, wcol)
        text::draw(fo, fmt0(c.wet_chance * 100.0) + "% rain", wx, cy + 78.0, 13, types::c_text_dim())
        if c.high_speed is text::draw(fo, "HIGH-SPEED CIRCUIT", sw / 2.0 - 80.0, cy + 54.0, 14, types::c_blue()) end
        if types::pit_stops_required(team.series) is
            text::draw(fo, "Pit delta: " + fmt0(c.pit_delta) + "s", sw / 2.0 - 60.0, cy + 78.0, 13, types::c_gold())
        end
    else is
        ui::panel(16.0, cy, sw - 32.0, 106.0, types::c_panel())
        text::draw(fo, "SEASON COMPLETE — Champions crowned!", 30.0, cy + 58.0, 26, types::c_gold())
    end

    ;; driver cards
    let dy: f64 = cy + 124.0
    ui::section_header(fo, "DRIVERS", dy)
    let mut i: int = 0
    while i < 2 is
        let mut driver: types::Driver = team.driver1
        if i == 1 is driver = team.driver2 end
        let dx: f64 = 16.0 + types::i2f(i) * (sw / 2.0 - 20.0)
        let dw: f64 = sw / 2.0 - 24.0
        ui::panel(dx, dy + 14.0, dw, 140.0, types::c_panel())
        text::draw(fo, driver.name, dx + 12.0, dy + 40.0, 20, types::c_text())
        text::draw(fo, "OVR " + to_string(types::driver_overall(driver)), dx + dw - 70.0, dy + 40.0, 19, types::c_accent())
        text::draw(fo, "Age " + to_string(driver.age) + " • " + driver.nationality + " • " + to_string(driver.career_wins) + " career wins", dx + 12.0, dy + 58.0, 12, types::c_text_dim())
        ui::stat_bar(fo, "PACE", driver.pace, dx + 12.0, dy + 72.0, dw - 24.0, types::c_accent())
        ui::stat_bar(fo, "CONSS", driver.consistency, dx + 12.0, dy + 90.0, dw - 24.0, types::c_blue())
        ui::stat_bar(fo, "WET", driver.wet_skill, dx + 12.0, dy + 108.0, dw - 24.0, types::rgba(0.3, 0.7, 1.0, 1.0))
        let mut mc: h2d_color::Color = types::c_accent()
        if driver.morale > 20 is
            mc = types::c_green()
        elsif driver.morale > 0 - 20 is
            mc = types::c_gold()
        end
        text::draw(fo, "Morale " + to_string(driver.morale) + " • " + to_string(driver.races) + " races", dx + 12.0, dy + 136.0, 12, mc)
        i += 1
    end

    ;; car
    let cary: f64 = dy + 172.0
    ui::section_header(fo, "CAR PERFORMANCE", cary)
    ui::panel(16.0, cary + 14.0, sw - 32.0, 80.0, types::c_panel())
    let cw: f64 = (sw - 32.0) / 5.0
    let car: types::Car = team.car
    let cnames: [string] = ["CHASSIS", "ENGINE", "RELIABILITY", "TIRE DEG", "PIT SPEED"]
    let cvals: [int] = [car.chassis, car.engine, car.reliability, car.tire_deg, car.pit_speed]
    let ccols: [h2d_color::Color] = [types::c_accent(), types::c_gold(), types::c_green(), types::c_blue(), types::c_silver()]
    i = 0
    while i < 5 is
        ui::stat_bar(fo, cnames[i], cvals[i], 16.0 + types::i2f(i) * cw + 4.0, cary + 28.0, cw - 8.0, ccols[i])
        i += 1
    end
    text::draw(fo, "Car Overall: " + to_string(types::car_performance(car)) + "  •  Aero Balance: " + to_string(car.aero_balance) + "/100", 30.0, cary + 80.0, 14, types::c_text_dim())

    ;; recent results (last three, newest first)
    let ry: f64 = cary + 108.0
    ui::section_header(fo, "RECENT RESULTS", ry)
    let n: int = team.race_results.len()
    let mut k: int = 0
    while k < 3 && k < n is
        let r: types::RaceResult = team.race_results[n - 1 - k]
        let rwy: f64 = ry + 20.0 + types::i2f(k) * 42.0
        ui::panel(16.0, rwy, sw - 32.0, 36.0, types::c_panel())
        text::draw(fo, "R" + to_string(r.round) + " " + r.circuit, 28.0, rwy + 22.0, 15, types::c_text_dim())
        ui::position_badge(fo, r.driver1_pos, 200.0, rwy + 7.0)
        ui::position_badge(fo, r.driver2_pos, 244.0, rwy + 7.0)
        text::draw(fo, "+" + to_string(r.driver1_points + r.driver2_points) + " pts", 296.0, rwy + 22.0, 15, types::c_gold())
        if r.wet_race is text::draw(fo, "WET", sw - 80.0, rwy + 22.0, 13, types::c_blue()) end
        if r.fastest_lap is text::draw(fo, "FL", sw - 48.0, rwy + 22.0, 13, types::rgba(0.6, 0.2, 0.9, 1.0)) end
        k += 1
    end
    return gs
end

