[package]
-> name        => starblaster
-> version     => 0.8.0
-> description => Starblaster — arcade space shooter (waves, boss, heat, graze/combo, Nova Bomb). H# + H2D.
-> authors     => ["HackerOS Team"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src => src

[dependencies]
-> H2D => newest

[commands]
-> make
--> run => bit build --release
--> description => Build starblaster (release, statically linked) into cache/build/release/starblaster
-> play
--> run => bit run
--> description => Build and run Starblaster
-> check
--> run => bit check
--> description => Syntax + type check of every module (no SDL needed)
-> smoke
--> run => SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy H2D_MAX_FRAMES=300 H2D_SCREENSHOT=smoke.png bit run
--> description => Headless run (SDL dummy driver), 300 frames + screenshot smoke.png — for CI
-> install
--> run => bit build --release && install -Dm755 cache/build/release/starblaster /usr/share/HackerOS/Scripts/HackerOS-Games/starblaster
--> description => Build release and copy the binary to /usr/share/HackerOS/Scripts/HackerOS-Games/ (needs root)
