use "bit -> silver" from "silver"
use "std -> fs"      from "fs"
use "std -> strings" from "str"
use "std -> time"    from "time"

mod paths
mod util

;; Queues `script` (POSIX sh) under job id `id`.
pub fn enqueue(id: string, script: string) is
    let name: string = paths::jobs_dir() + "/" + to_string(time::now_ms()) + "-" + id + ".job"
    fs::write(name + ".part", id + "\n" + script)
    fs::rename(name + ".part", name)
end

;; Starts every queued job. Call from on_tick.
pub fn pump(a: app::App) -> app::App is
    let dir: string = paths::jobs_dir()
    let names: [string] = fs::list_dir(dir)
    let mut x: app::App = a
    let mut i: int = 0
    while i < array_len(names) is
        let n: string = names[i]
        i += 1
        if !string_ends_with(n, ".job") is continue end
        let mut p: string = n
        if !string_starts_with(n, "/") is p = dir + "/" + n end
        let txt: string = fs::read(p)
        fs::remove(p)
        let parts: [string] = str::splitn(txt, "\n", 2)
        if array_len(parts) < 2 is continue end
        x = app::spawn_task(x, parts[0], parts[1], "")
    end
    return x
end
