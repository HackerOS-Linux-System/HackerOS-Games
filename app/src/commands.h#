fn flag(key: string, v: bool) -> string is
    return data::set_bool(data::object(), key, v)
end

;; ───────────────────────── built-in games ─────────────────────────

pub fn check_game_exists(args: string) -> string is
    return flag("exists", games::files_present(games::builtin(data::get_str(args, "gameId"))))
end

;; Shared by every launch command: preflight, sandbox, detach, playtime bookkeeping.
fn start(id: string, l: games::Launch, extra: [string]) -> string is
    if !games::startable(l) is return util::fail("launch_failed", games::why_not(l, id)) end
    ;; native binaries: make sure they carry the exec bit (best effort, like the Rust version)
    if string_starts_with(l.cmd, "/") && array_len(l.args) == 0 is
        process::run("chmod 755 " + util::shq(l.cmd) + " 2>/dev/null")
    end
    let pid: int = sandbox::run_detached(id, sandbox::line(sandbox::argv(l.cmd, l.args, extra)))
    if pid < 0 is return util::fail("launch_failed", "Failed to launch " + id) end
    store::update_playtime(id, 0, 1)
    return flag("ok", true)
end

pub fn launch_game(args: string) -> string is
    let id: string = data::get_str(args, "gameId")
    let l: games::Launch = games::builtin(id)
    if !l.ok is return util::fail("not_found", l.error) end
    let cfg: string = store::settings_for(id)
    let mut extra: [string] = []
    if data::get_bool(cfg, "fullscreen") is extra = array_push(extra, "--fullscreen") end
    let more: [string] = str::split_whitespace(data::get_str(cfg, "launchArgs"))
    let mut i: int = 0
    while i < array_len(more) is
        extra = array_push(extra, more[i])
        i += 1
    end
    return start(id, l, extra)
end

pub fn record_playtime(args: string) -> string is
    let id: string = data::get_str(args, "gameId")
    let secs: int = data::get_int(args, "seconds")
    if !util::valid_id(id) || secs < 0 is return util::fail("invalid_args", "Invalid playtime record") end
    store::update_playtime(id, secs, 0)
    return util::ok()
end

pub fn get_all_playtime(args: string) -> string is
