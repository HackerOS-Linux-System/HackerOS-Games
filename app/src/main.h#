use "bit -> silver" from "silver"
use "std -> env"     from "env"

mod util
mod paths
mod store
mod games
mod sandbox
mod jobs
mod commands
;; generated by `npm run embed` (frontend/embed.mjs) — the whole frontend baked into the binary
mod assets_gen

fn on_tick(a: app::App) -> app::App is
    return jobs::pump(a)
end

fn main() is
    ;; before app::new: Wayland app_id / X11 WM_CLASS (matches hackeros-games.desktop) and
    ;; a single running instance — a second launch just focuses the first.
    app::set_app_id("com.hackeros.games")
    if !app::single_instance("com.hackeros.games", env::args()) is return end

    ;; serve the frontend from memory (falls back to ./frontend/ when running unembedded)
    assets_gen::install()

    let mut a = app::new("HackerOS Games", 1280, 800)
    a = app::remember_window(a, "hackeros-games")
    a = app::set_min_size(a, 900, 600)
    ;; no system title bar — the frontend draws its own (CSS `app-region: drag`)
    a = app::set_frameless(a, 6)
    a = app::set_theme(a, "dark")
    a = app::set_icon(a, "frontend/images/icon.png")

    a = app::load_html(a, "frontend/index.html")
    a = app::load_css(a, "frontend/style.css")

    a = app::command(a, "check_game_exists", commands::check_game_exists)
    a = app::command(a, "launch_game", commands::launch_game)
    a = app::command(a, "record_playtime", commands::record_playtime)
    a = app::command(a, "get_all_playtime", commands::get_all_playtime)
    a = app::command(a, "save_game_settings", commands::save_game_settings)
    a = app::command(a, "get_all_game_settings", commands::get_all_game_settings)
    a = app::command(a, "get_app_settings", commands::get_app_settings)
    a = app::command(a, "save_app_settings", commands::save_app_settings)
    a = app::command(a, "check_addons_installed", commands::check_addons_installed)
    a = app::command(a, "install_addons", commands::install_addons)
    a = app::command(a, "check_addon_game_exists", commands::check_addon_game_exists)
    a = app::command(a, "launch_addon_game", commands::launch_addon_game)
    a = app::command(a, "open_url", commands::open_url)
    a = app::command(a, "install_community_game", commands::install_community_game)
    a = app::command(a, "finalize_community_install", commands::finalize_community_install)
    a = app::command(a, "launch_community_game", commands::launch_community_game)
    a = app::command(a, "uninstall_community_game", commands::uninstall_community_game)
    a = app::command(a, "get_community_installs", commands::get_community_installs)
    a = app::command(a, "check_community_game_installed", commands::check_community_game_installed)
    a = app::command(a, "cache_images", commands::cache_images)

    a = app::on_tick(a, on_tick)
    a = app::set_tick_interval(a, 250)

    a = app::load_js(a, ["frontend/dist/app.js"])
    ;; HACKEROS_GAMES_DEV=1 → reload the page whenever frontend files change (use with `npm run watch`)
    if env::get("HACKEROS_GAMES_DEV") == "1" is a = app::enable_hot_reload(a) end
    app::run(a)
end
