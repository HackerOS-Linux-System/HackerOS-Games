;; constructors used by the generated levels.h#
pub fn plat(x: f64, y: f64, w: f64, h: f64) -> Platform is
    return Platform { x: x, y: y, width: w, height: h, moving: false, speed: 0.0, range: 0.0, base_x: 0.0, base_y: 0.0, axis_y: false, rotating: false, center_x: 0.0, center_y: 0.0, radius: 0.0 }
end

pub fn plat_moving(x: f64, y: f64, w: f64, h: f64, speed: f64, range: f64, base_x: f64, base_y: f64, axis_y: bool) -> Platform is
    return Platform { x: x, y: y, width: w, height: h, moving: true, speed: speed, range: range, base_x: base_x, base_y: base_y, axis_y: axis_y, rotating: false, center_x: 0.0, center_y: 0.0, radius: 0.0 }
end

pub fn plat_rot(x: f64, y: f64, w: f64, h: f64, speed: f64, cx: f64, cy: f64, radius: f64) -> Platform is
    return Platform { x: x, y: y, width: w, height: h, moving: false, speed: speed, range: 0.0, base_x: 0.0, base_y: 0.0, axis_y: false, rotating: true, center_x: cx, center_y: cy, radius: radius }
end

pub fn spike(x: f64, y: f64, w: f64, h: f64) -> Spike is
    return Spike { x: x, y: y, width: w, height: h }
end

pub fn dat(x: f64, y: f64) -> DataItem is
    return DataItem { x: x, y: y, collected: false }
end

pub fn enemy(kind: int, x: f64, y: f64, radius: f64, speed: f64, dir: f64, range: f64, base_x: f64, base_y: f64) -> Enemy is
    return Enemy { x: x, y: y, radius: radius, speed: speed, dir: dir, range: range, base_x: base_x, base_y: base_y, kind: kind,
        disabled: false, disabled_timer: 0.0, health: 0, max_health: 0, shoot_timer: 0.0, shoot_interval: 0.0, burst_count: 0, phase: 1, projectiles: [] }
end

pub fn boss(kind: int, x: f64, y: f64, radius: f64, speed: f64, dir: f64, range: f64, base_x: f64, hp: int, shoot_timer: f64, shoot_interval: f64, phase: int) -> Enemy is
    return Enemy { x: x, y: y, radius: radius, speed: speed, dir: dir, range: range, base_x: base_x, base_y: 0.0, kind: kind,
        disabled: false, disabled_timer: 0.0, health: hp, max_health: hp, shoot_timer: shoot_timer, shoot_interval: shoot_interval, burst_count: 0, phase: phase, projectiles: [] }
end

pub fn powerup(x: f64, y: f64, kind: int) -> Powerup is
    return Powerup { x: x, y: y, kind: kind, collected: false }
end

pub fn fspike(x: f64, y: f64, w: f64, h: f64, speed: f64) -> FallingSpike is
    return FallingSpike { x: x, y: y, width: w, height: h, speed: speed }
end

pub fn is_boss(kind: int) -> bool is
    return kind == 2 || kind == 3 || kind == 4
end

