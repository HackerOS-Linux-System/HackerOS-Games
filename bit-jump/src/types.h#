    pub multiplier:   f64
    pub combo_timer:  f64
    pub hit_this_level: bool
    pub achievements: [bool]
    pub notif_text:   [string]      ;; achievementNotifQueue
    pub notif_timer:  [f64]
    pub rebind_key:   int           ;; -1 none, else 0 jump .. 3 right
    pub gravity:      f64
    pub player:       Player
    pub camera_x:     f64
    pub shake_timer:  f64
    pub shake_intensity: f64
    pub menu_time:    f64
