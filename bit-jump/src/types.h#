use "bit -> h2d"

;; Bit Jump — types.h#  (state that used to be Lua globals)
;;
;; Lua kept the whole game in global tables; H# has no globals, so everything lives in
;; one `Game` value that is passed in and returned by every function (like H2D's examples).
;; Lua string tags become ints: enemy type, power-up type, game mode, game state, shape.

pub fn rgba(r: f64, g: f64, b: f64, a: f64) -> h2d_color::Color is
    return h2d_color::color(f2i(r * 255.0 + 0.5), f2i(g * 255.0 + 0.5), f2i(b * 255.0 + 0.5), f2i(a * 255.0 + 0.5))
end

pub fn f2i(x: f64) -> int is
    return __builtin_conv_float_to_int(x)
end

pub fn i2f(n: int) -> f64 is
    return n + 0.0
end

;; math.floor for any sign
pub fn floor_i(x: f64) -> int is
    let n: int = __builtin_conv_float_to_int(x)
    if (n + 0.0) > x is return n - 1 end
    return n
end

;; Lua's `a % m` for m > 0 (result in [0, m))
pub fn lmod(a: f64, m: f64) -> f64 is
    return a - m * (floor_i(a / m) + 0.0)
end

pub fn fabs(x: f64) -> f64 is
    if x < 0.0 is return 0.0 - x end
    return x
end

pub fn fmax(a: f64, b: f64) -> f64 is
    if a > b is return a end
    return b
end

pub fn fmin(a: f64, b: f64) -> f64 is
    if a < b is return a end
    return b
end

;; math.random(lo, hi) — inclusive ints
pub fn rand_i(lo: int, hi: int) -> int is
    return h2d_random::range(lo, hi)
end

