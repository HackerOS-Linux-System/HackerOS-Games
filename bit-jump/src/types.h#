;; ── settings ──────────────────────────────────────────────────────────────
;; settingsOptions[i].selected (0-based here): difficulty, fullscreen, resolution,
;; graphics quality, player shape; the four Rebind rows keep their key in `keys`.
pub struct Settings is
    pub difficulty: int        ;; 0 very easy .. 4 insane
    pub fullscreen: bool
    pub res_index:  int        ;; 0 800x600 .. 4 2560x1440
    pub graphics:   int        ;; 0 low .. 3 ultra
    pub theme:      int        ;; 0 dark, 1 light, 2 neon, 3 retro
    pub keys:       [int]      ;; jump, hack, left, right (h2d_keys codes)
end

