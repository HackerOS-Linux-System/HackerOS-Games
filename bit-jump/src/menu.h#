;; ── update / keys ─────────────────────────────────────────────────────────
pub fn update_menu(mut g: types::Game, dt: f64) -> types::Game is
    g.menu_time += dt
    return g
end

pub fn start_game(mut g: types::Game, lvl: int) -> types::Game is
    g.state = types::st_game()
    g.current_level = lvl
    g.infinite_lives = g.game_mode == types::gm_practice()
    g.lives = 3
    g.score = 0.0
    g.game_over = false
    g.game_won = false
    return level::load_level(g, g.current_level)
end

;; selection moves with wrap-around: dir -1 / +1 over 1..n
fn step(sel: int, dir: int, n: int) -> int is
    let mut s: int = sel + dir
    if s < 1 is s = n end
    if s > n is s = 1 end
    return s
end

fn to_menu(mut g: types::Game) -> types::Game is
    g.state = types::st_menu()
    g.selected_menu = 1
    return g
end

fn confirm() -> bool is
    return pressed(h2d_keys::key_enter()) || pressed(h2d_keys::key_space())
end

;; handleKeyPressed — one call per frame, acts on the keys pressed this frame
pub fn handle_key_pressed(mut g: types::Game) -> types::Game is
    let up: bool = pressed(h2d_keys::key_up())
    let down: bool = pressed(h2d_keys::key_down())
    let esc: bool = pressed(h2d_keys::key_escape())
    let st: int = g.state

    if st == types::st_game() is
        if pressed(h2d_keys::key_r()) && (g.game_over || g.game_won) is
            g.infinite_lives = g.game_mode == types::gm_practice()
            g.lives = 3
            g = level::load_level(g, g.current_level)
            g.score = 0.0
            g.game_over = false
            g.game_won = false
        elsif (esc || pressed(h2d_keys::key_p())) && !g.game_over && !g.game_won is
            g.state = types::st_pause()
            g.selected_pause = 1
        end
        return g
    end

    if st == types::st_menu() is
        if up is
            g.selected_menu = step(g.selected_menu, 0 - 1, 8)
        elsif down is
            g.selected_menu = step(g.selected_menu, 1, 8)
        elsif confirm() is
            let s: int = g.selected_menu
            if s == 1 is
                g = start_game(g, 1)
            elsif s == 2 is
                g.state = types::st_level_select()
                g.selected_level = 1
            elsif s == 3 is
                g.state = types::st_game_modes()
                g.selected_mode = 1
            elsif s == 4 is
                g.state = types::st_settings()
                g.selected_setting = 1
            elsif s == 5 is
                g.state = types::st_achievements()
                g.selected_achievement = 1
            elsif s == 6 is
                g.state = types::st_themes()
                g.selected_theme = 1
            elsif s == 7 is
                g.state = types::st_credits()
            else is
                g.quit = true
            end
        end
        return g
    end

    if st == types::st_level_select() is
        if up is
            g.selected_level = step(g.selected_level, 0 - 1, levels::count())
        elsif down is
            g.selected_level = step(g.selected_level, 1, levels::count())
        elsif confirm() is
            if g.selected_level <= g.highest_level is g = start_game(g, g.selected_level) end
        elsif esc is
            g = to_menu(g)
        end
        return g
    end

    if st == types::st_game_modes() is
        if up is
            g.selected_mode = step(g.selected_mode, 0 - 1, 4)
        elsif down is
            g.selected_mode = step(g.selected_mode, 1, 4)
        elsif confirm() is
            g.game_mode = g.selected_mode - 1
            g = start_game(g, 1)
        elsif esc is
            g = to_menu(g)
        end
        return g
    end

    if st == types::st_settings() is
        if up is
            g.selected_setting = step(g.selected_setting, 0 - 1, settings::option_count())
        elsif down is
            g.selected_setting = step(g.selected_setting, 1, settings::option_count())
        elsif pressed(h2d_keys::key_left()) is
            g = settings::update_settings(g, false)
        elsif pressed(h2d_keys::key_right()) is
            g = settings::update_settings(g, true)
        elsif confirm() is
            if g.selected_setting >= 6 is
                g.state = types::st_rebind()
                g.rebind_key = g.selected_setting - 6
            end
        elsif esc is
            g = to_menu(g)
        end
        return g
    end

    if st == types::st_rebind() is
        let code: int = h2d_input2d::key_pressed_code()
        if code >= 0 is
            if code != h2d_keys::key_escape() is
                g.settings.keys[g.rebind_key] = code
                g = settings::apply_settings(g)
            end
            g.state = types::st_settings()
        end
        return g
    end

    if st == types::st_achievements() is
        if up is
            g.selected_achievement = step(g.selected_achievement, 0 - 1, types::ach_count())
        elsif down is
            g.selected_achievement = step(g.selected_achievement, 1, types::ach_count())
        elsif esc is
            g = to_menu(g)
        end
        return g
    end

    if st == types::st_pause() is
        if up is
            g.selected_pause = step(g.selected_pause, 0 - 1, 3)
        elsif down is
            g.selected_pause = step(g.selected_pause, 1, 3)
        elsif confirm() is
            if g.selected_pause == 1 is
                g.state = types::st_game()
            elsif g.selected_pause == 2 is
                g.state = types::st_settings()
                g.selected_setting = 1
            else is
                g = to_menu(g)
            end
        elsif esc || pressed(h2d_keys::key_p()) is
            g.state = types::st_game()
        end
        return g
    end

    if st == types::st_credits() is
        if esc is g = to_menu(g) end
        return g
    end

    if st == types::st_themes() is
        if up is
            g.selected_theme = step(g.selected_theme, 0 - 1, 4)
        elsif down is
            g.selected_theme = step(g.selected_theme, 1, 4)
        elsif confirm() is
            g.settings.theme = g.selected_theme - 1
            g = settings::apply_settings(g)
        elsif esc is
            g = to_menu(g)
        end
        return g
    end
    return g
end
