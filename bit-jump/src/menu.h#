;; ── background / title ────────────────────────────────────────────────────
pub fn draw_menu_background(g: types::Game) is
    let w: f64 = h2d_gfx::screen_width() + 0.0
    let h: f64 = h2d_gfx::screen_height() + 0.0
    let th: [f64] = util::theme_colors(g.settings.theme)
    h2d_gfx::clear_background(rgba(th[0], th[1], th[2], 1.0))
    let c: h2d_color::Color = rgba(th[3], th[4], th[5], 0.3)
    let mut x: f64 = types::lmod(g.menu_time * 15.0, 80.0)
    while x <= w + 80.0 is
        h2d_gfx::draw_line(x, 0.0, x, h, 1.0, c)
        x += 80.0
    end
    let mut y: f64 = types::lmod(g.menu_time * 10.0, 60.0)
    while y <= h + 60.0 is
        h2d_gfx::draw_line(0.0, y, w, y, 1.0, c)
        y += 60.0
    end
end

fn draw_title(fo: text::Fonts, g: types::Game, logo: h2d_texture::Texture2D, y_pos: f64) is
    let w: f64 = h2d_gfx::screen_width() + 0.0
    if h2d_texture::is_valid(logo) is
        let iw: f64 = logo.width + 0.0
        let ih: f64 = logo.height + 0.0
        let scale: f64 = types::fmin(300.0 / iw, 80.0 / ih)
        h2d_texture::draw_texture_ex(logo, w / 2.0 - iw * scale / 2.0, y_pos, iw * scale, ih * scale, 0.0, 0.0, 0.0, false, false, rgba(1.0, 1.0, 1.0, 1.0))
    else is
        let pulse: f64 = 0.9 + 0.1 * m::sin(g.menu_time * 2.0)
        text::draw_top(fo, "BIT JUMP", w / 2.0 - 80.0, y_pos, 26, rgba(0.0, pulse, pulse, 1.0))
    end
end

;; ── screens ───────────────────────────────────────────────────────────────
pub fn draw_menu(fo: text::Fonts, g: types::Game, logo: h2d_texture::Texture2D) is
    draw_menu_background(g)
    draw_title(fo, g, logo, 50.0)
    let cx: f64 = (h2d_gfx::screen_width() + 0.0) / 2.0 - 80.0
    let opts: [string] = menu_options()
    let mut i: int = 0
    while i < opts.len() is
        let y: f64 = 170.0 + types::i2f(i) * 42.0
        if i + 1 == g.selected_menu is
            text::draw_top(fo, opts[i], cx, y, 15, yellow())
        else is
            text::draw_top(fo, opts[i], cx, y, 12, theme_text(g))
        end
        i += 1
    end
end

pub fn draw_level_select(fo: text::Fonts, g: types::Game) is
    draw_menu_background(g)
    let w: f64 = h2d_gfx::screen_width() + 0.0
    let tc: h2d_color::Color = theme_text(g)
    text::draw_top(fo, "Wybór Poziomu", w / 2.0 - 100.0, 60.0, 22, tc)
    let cx: f64 = w / 2.0 - 100.0
    let n: int = levels::count()
    let mut i: int = 1
    while i <= n is
        let locked: bool = i > g.highest_level
        let mut state_txt: string = "[ODBLOKOWANY]"
        if locked is state_txt = "[ZABLOKOWANY]" end
        let label: string = "Poziom " + str::pad_start(to_string(i), 2, " ") + "  " + state_txt
        let y: f64 = 120.0 + types::i2f(i - 1) * 32.0
        if i == g.selected_level is
            text::draw_top(fo, label, cx, y, 13, yellow())
        else is
            text::draw_top(fo, label, cx, y, 12, tc)
        end
        i += 1
    end
    text::draw_top(fo, "Esc – powrót", cx, 120.0 + types::i2f(n) * 32.0 + 16.0, 12, tc)
end

pub fn draw_game_modes(fo: text::Fonts, g: types::Game) is
    draw_menu_background(g)
    let w: f64 = h2d_gfx::screen_width() + 0.0
    let cx: f64 = w / 2.0 - 100.0
    let tc: h2d_color::Color = theme_text(g)
    text::draw_top(fo, "Tryby Gry", w / 2.0 - 70.0, 80.0, 22, tc)
    let descs: [string] = [
        "Normal     – klasyczna gra, 3 życia",
        "Time Attack – ścig z czasem na każdym poziomie",
        "Endless    – nieskończona pętla, rosnąca prędkość",
        "Practice   – nieskończone życia, idealne do nauki",
    ]
    let mut i: int = 0
    while i < descs.len() is
        let mut c: h2d_color::Color = tc
        if i + 1 == g.selected_mode is c = yellow() end
        text::draw_top(fo, descs[i], cx, 180.0 + types::i2f(i) * 55.0, 12, c)
        i += 1
    end
    text::draw_top(fo, "Esc – powrót", cx, 420.0, 12, tc)
end

pub fn draw_pause(fo: text::Fonts, g: types::Game) is
    let w: f64 = h2d_gfx::screen_width() + 0.0
    let h: f64 = h2d_gfx::screen_height() + 0.0
    h2d_gfx::draw_rectangle(0.0, 0.0, w, h, rgba(0.0, 0.0, 0.0, 0.55))
    let tc: h2d_color::Color = theme_text(g)
    text::draw_top(fo, "PAUZA", w / 2.0 - 40.0, 120.0, 24, tc)
    let cx: f64 = w / 2.0 - 60.0
    let opts: [string] = pause_options()
    let mut i: int = 0
    while i < opts.len() is
        let mut c: h2d_color::Color = tc
        if i + 1 == g.selected_pause is c = yellow() end
        text::draw_top(fo, opts[i], cx, 220.0 + types::i2f(i) * 50.0, 12, c)
        i += 1
    end
end

pub fn draw_achievements(fo: text::Fonts, g: types::Game) is
    draw_menu_background(g)
    let w: f64 = h2d_gfx::screen_width() + 0.0
    let cx: f64 = w / 2.0 - 160.0
    let tc: h2d_color::Color = theme_text(g)
    text::draw_top(fo, "Osiągnięcia", w / 2.0 - 80.0, 60.0, 22, tc)
    let mut i: int = 0
    while i < types::ach_count() is
        let unlocked: bool = g.achievements[i]
        let mut c: h2d_color::Color = rgba(0.5, 0.5, 0.5, 1.0)
        if i + 1 == g.selected_achievement is
            c = yellow()
        elsif unlocked is
            c = rgba(0.3, 1.0, 0.5, 1.0)
        end
        let mut status: string = "✗"
        if unlocked is status = "✓" end
        text::draw_top(fo, status + "  " + ach_description(i), cx, 120.0 + types::i2f(i) * 36.0, 12, c)
        i += 1
    end
    text::draw_top(fo, "Esc – powrót", cx, 120.0 + types::i2f(types::ach_count()) * 36.0 + 16.0, 12, tc)
end

