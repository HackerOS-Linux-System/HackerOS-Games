;; Bit Jump — menu.h#  (port of src/menu.lua)

fn rgba(r: f64, g: f64, b: f64, a: f64) -> h2d_color::Color is
    return types::rgba(r, g, b, a)
end

fn pressed(k: int) -> bool is
    return h2d_input2d::is_key_pressed(k)
end

fn yellow() -> h2d_color::Color is
    return rgba(1.0, 1.0, 0.0, 1.0)
end

fn theme_text(g: types::Game) -> h2d_color::Color is
    return util::arr_color(util::theme_colors(g.settings.theme), 9, 1.0)
end

