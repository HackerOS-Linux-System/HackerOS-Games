use "bit -> H2D"

mod types
mod util
mod text

;; Bit Jump — settings.h#  (port of src/settings.lua)

pub fn difficulty_name(i: int) -> string is
    let n: [string] = ["Very Easy", "Easy", "Normal", "Hard", "Insane"]
    return n[i]
end

pub fn res_label(i: int) -> string is
    let n: [string] = ["800x600", "1024x768", "1280x720", "1920x1080", "2560x1440"]
    return n[i]
end

pub fn res_w(i: int) -> int is
    let n: [int] = [800, 1024, 1280, 1920, 2560]
    return n[i]
end

pub fn res_h(i: int) -> int is
    let n: [int] = [600, 768, 720, 1080, 1440]
    return n[i]
end

pub fn quality_name(i: int) -> string is
    let n: [string] = ["Low", "Medium", "High", "Ultra"]
    return n[i]
end

pub fn shape_name(i: int) -> string is
    let n: [string] = ["Square", "Circle", "Triangle"]
    return n[i]
end

pub fn new_settings() -> types::Settings is
    return types::Settings {
        difficulty: 2, fullscreen: false, res_index: 0, graphics: 1, theme: 0,
        keys: [h2d_keys::key_space(), h2d_keys::key_h(), h2d_keys::key_left(), h2d_keys::key_right()],
    }
end

;; love key name of an h2d_keys code (for "Current: space")
pub fn key_label(code: int) -> string is
    if code >= 0 && code <= 25 is
        let letters: [string] = ["a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l", "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"]
        return letters[code]
    end
    if code >= 26 && code <= 35 is return to_string(code - 26) end
    if code == 36 is return "up" end
    if code == 37 is return "down" end
    if code == 38 is return "left" end
    if code == 39 is return "right" end
    if code == 40 is return "space" end
    if code == 41 is return "return" end
    if code == 42 is return "escape" end
    if code == 43 is return "tab" end
    if code == 44 is return "lshift" end
    if code == 45 is return "rshift" end
    if code == 46 is return "lctrl" end
    if code == 47 is return "rctrl" end
    if code == 48 is return "backspace" end
    return "key" + to_string(code)
end

;; the 9 rows of settingsOptions: name + current value text
fn option_name(i: int) -> string is
    let n: [string] = ["Difficulty", "Fullscreen", "Resolution", "Graphics Quality", "Player Shape", "Rebind Jump", "Rebind Hack", "Rebind Left", "Rebind Right"]
    return n[i]
end

pub fn option_count() -> int is
    return 9
end

fn option_value(g: types::Game, i: int) -> string is
    let s: types::Settings = g.settings
    if i == 0 is return difficulty_name(s.difficulty) end
    if i == 1 is
        if s.fullscreen is return "On" end
        return "Off"
    end
    if i == 2 is return res_label(s.res_index) end
    if i == 3 is return quality_name(s.graphics) end
    if i == 4 is return shape_name(g.player.shape) end
    return "Current: " + key_label(s.keys[i - 5])
end

;; applySettings(): difficulty -> speed/gravity, window mode, player shape
pub fn apply_settings(mut g: types::Game) -> types::Game is
    let d: int = g.settings.difficulty
    if d == 0 is
        g.player.auto_speed = 100.0
        g.gravity = 600.0
    elsif d == 1 is
        g.player.auto_speed = 150.0
        g.gravity = 800.0
    elsif d == 2 is
        g.player.auto_speed = 200.0
        g.gravity = 1000.0
    elsif d == 3 is
        g.player.auto_speed = 250.0
        g.gravity = 1200.0
    else is
        g.player.auto_speed = 300.0
        g.gravity = 1500.0
    end
    h2d_gfx::set_fullscreen(g.settings.fullscreen)
    h2d_gfx::set_window_size(res_w(g.settings.res_index), res_h(g.settings.res_index))
    return g
end

;; Left / Right on the selected row (updateSettings)
pub fn update_settings(mut g: types::Game, is_right: bool) -> types::Game is
    let row: int = g.selected_setting - 1
    if is_right is
        if row == 0 is g.settings.difficulty = (g.settings.difficulty + 1) % 5 end
        if row == 1 is g.settings.fullscreen = !g.settings.fullscreen end
        if row == 2 is g.settings.res_index = (g.settings.res_index + 1) % 5 end
        if row == 3 is g.settings.graphics = (g.settings.graphics + 1) % 4 end
        if row == 4 is g.player.shape = (g.player.shape + 1) % 3 end
    else is
        if row == 0 is g.settings.difficulty = (g.settings.difficulty + 4) % 5 end
        if row == 1 is g.settings.fullscreen = !g.settings.fullscreen end
        if row == 2 is g.settings.res_index = (g.settings.res_index + 4) % 5 end
        if row == 3 is g.settings.graphics = (g.settings.graphics + 3) % 4 end
        if row == 4 is g.player.shape = (g.player.shape + 2) % 3 end
    end
    return apply_settings(g)
end

pub fn draw_settings(fo: text::Fonts, g: types::Game) is
    let th: [f64] = util::theme_colors(g.settings.theme)
    text::draw_top(fo, "Settings", 300.0, 80.0, 24, util::arr_color(th, 9, 1.0))
    let mut i: int = 0
    while i < option_count() is
        let mut c: h2d_color::Color = util::arr_color(th, 9, 1.0)
        if i + 1 == g.selected_setting is c = types::rgba(1.0, 1.0, 0.0, 1.0) end
        text::draw_top(fo, option_name(i) + ": " + option_value(g, i), 220.0, 150.0 + types::i2f(i) * 36.0, 12, c)
        i += 1
    end
    text::draw_top(fo, "Left/Right - zmiana, Enter - rebind, Esc - powrót", 200.0, 500.0, 12, util::arr_color(th, 9, 1.0))
end
