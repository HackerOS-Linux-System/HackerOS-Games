[package]
-> name        => bit-jump
-> version     => 0.8.0
-> description => Bit Jump — Geometry-Dash-style auto-runner: 14 levels, 3 bosses, power-ups, achievements. H# + H2D.
-> authors     => ["HackerOS Team <hackeros068@gmail.com>"]
-> license     => MIT
-> lang        => h#

[edition]
-> edition   => 2026
-> toolchain => 0.9

[layout]
-> src => src

[dependencies]
-> H2D => newest

[commands]
-> make
--> run => bit build --release
--> description => Build bit-jump (release, statically linked) into cache/build/release/bit-jump
-> play
--> run => bit run
--> description => Build and run Bit Jump
-> check
--> run => bit check
--> description => Syntax + type check of every module (no SDL needed)
-> smoke
--> run => SDL_VIDEODRIVER=dummy SDL_AUDIODRIVER=dummy H2D_MAX_FRAMES=300 H2D_SCREENSHOT=smoke.png bit run
--> description => Headless run (SDL dummy driver), 300 frames + screenshot smoke.png — for CI
-> install
--> run => bit build --release && install -Dm755 cache/build/release/bit-jump /usr/share/HackerOS/Scripts/HackerOS-Games/bit-jump
--> description => Build release and copy the binary to /usr/share/HackerOS/Scripts/HackerOS-Games/ (needs root)

[system-dependencies]
-> sdl2
--> pkg-config => sdl2
--> header => SDL2/SDL.h
--> lib => SDL2
--> apt => libsdl2-dev
--> dnf => SDL2-devel
--> pacman => sdl2
--> apk => sdl2-dev
--> zypper => libSDL2-devel
--> brew => sdl2
-> SDL2_gfx
--> pkg-config => SDL2_gfx
--> header => SDL2/SDL2_gfxPrimitives.h
--> lib => SDL2_gfx
--> apt => libsdl2-gfx-dev
--> dnf => SDL2_gfx-devel
--> pacman => sdl2_gfx
--> apk => sdl2_gfx-dev
--> zypper => libSDL2_gfx-devel
--> brew => sdl2_gfx
